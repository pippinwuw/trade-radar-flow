# 生产环境使用真实 pi Agent；离线验证样例由独立入口显式调用。
PI_AGENT_MODE=live

# pi Agent 使用下面的供应商和模型。
PI_PROVIDER=anthropic
PI_MODEL=claude-sonnet-4-5
# 模型调用本地超时：普通 Agent 3 分钟，查询规划/公司分析 5 分钟，
# 主 Agent 最长 10 分钟（包含其内部工具调用的子 Agent 时间）。
PI_AGENT_TIMEOUT_MS=180000
SEARCH_PLANNING_AGENT_TIMEOUT_MS=300000
COMPANY_ANALYSIS_AGENT_TIMEOUT_MS=300000
COMPANY_ANALYSIS_AGENT_MAX_TOOL_CALLS=30
ORCHESTRATOR_AGENT_TIMEOUT_MS=600000

# 只填写所选供应商对应的密钥；不要提交真实 .env。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Serper 本地化 Google 搜索（兼容旧变量名 SERPAPI_API_KEY）。
SERPER_API_KEY=

# 官网抓取（进程内 Node 实现；旧 PYTHON_CRAWLER_* 名称仍可用）。
CRAWLER_WORKERS=5
COMPANY_ANALYSIS_CONCURRENCY=50
COMPANY_ANALYSIS_ACTIVE_LIMIT=12
CRAWLER_TIMEOUT_MS=120000
CRAWLER_RETRIES=2
CRAWLER_DOMAIN_DEADLINE_SECONDS=75
COMPANY_ANALYSIS_RETRIES=2
CRAWLER_MAX_HTML_BYTES=4000000
# 同一域名、页面预算和清洗配置在有效期内复用，避免重复抓取。
CRAWLER_CACHE_TTL_DAYS=7
# 未显式传参时默认启用正文正则去噪；设为 false/0/off/no 可关闭默认行为。
CRAWLER_REGEX_CLEANING=true

# 留空时使用 data/trade-radar.db；测试可设为 :memory:。
DATABASE_PATH=

# MarketPolicy 正文使用外部版本化 JSON；留空时使用 data/market-policies。
MARKET_POLICY_DATA_DIR=

# 结构化日志：debug | info | warn | error。默认写入 logs/。
LOG_LEVEL=info
LOG_DIR=

PORT=3210
